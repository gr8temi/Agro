# Copy to .env.local (gitignored) to override settings for local development.
# Restart `npx expo start` after changing these.

# Backend API base URL. Defaults to production when unset.
# Use your Mac's LAN IP (ipconfig getifaddr en0), not localhost, so a phone can reach it.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8001/api
